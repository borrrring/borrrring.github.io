---
import { Footer } from 'astro-pure/components/basic'
import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import CustomHeader from '@/components/CustomHeader.astro'
import PageTransition from '@/components/PageTransition.astro'
import config from '@/site-config'

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseLayout /> component.
import '@/assets/styles/global.css'
import '@/assets/styles/app.css'

interface Props {
  meta: SiteMeta
  highlightColor?: string
}

const {
  meta: { articleDate, description = config.description, ogImage, title },
  highlightColor = '#4A8BC2',
  ...props
} = Astro.props
---

<html lang={config.locale.lang} class='overflow-y-scroll'>
  <head>
    <BaseHead {articleDate} {description} {ogImage} {title} />
  </head>

  <body class='bg-background text-foreground' {...props}>
    <div
      id='highlight-gradient'
      class='pointer-events-none absolute start-0 top-0 z-0 h-screen w-full opacity-25'
      style={`background-image:linear-gradient(${highlightColor},transparent)`}
    >
    </div>
    <!-- Furina full-page background image -->
    <div id='furina-bg'></div>
    <div id='furina-overlay'></div>
    <!-- Floating bubbles -->
    <div id='furina-bubbles' class='pointer-events-none fixed inset-0 z-0 overflow-hidden'>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
      <span class='bubble'></span>
    </div>
    <!-- Background effects: legacy overlay -->
    <div id='bg-effects' class='pointer-events-none fixed inset-0 z-0'></div>
    <div
      id='main-container'
      class='mx-auto w-full max-w-[70rem] min-h-[100dvh] flex flex-col justify-between'
    >
      <CustomHeader />
      <div class='flex-1 w-full'>
        <slot />
      </div>
      <Footer />
    </div>

    {/* Set highlight color */}
    <style define:vars={{ highlightColor }}>
      :global(.highlight) {
        --highlight-fg: color-mix(
          in srgb,
          var(--highlightColor) 40%,
          hsl(var(--foreground)/var(--un-text-opacity, 1))
        );
        color: var(--highlight-fg, hsl(var(--primary) / var(--un-text-opacity))) !important;
      }
      :global(.highlight-bg) {
        background-color: var(
          --highlightColor,
          hsl(var(--primary) / var(--un-text-opacity))
        ) !important;
      }

      /* Extend safe area for some special screens
       * https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/env
       * https://webkit.org/blog/7929/designing-websites-for-iphone-x/
       */
      #main-container {
        padding-top: env(safe-area-inset-top);
        padding-left: calc(1rem + env(safe-area-inset-left));
        padding-right: calc(1rem + env(safe-area-inset-right));
      }
      @media (min-width: 640px) {
        #main-container {
          padding-left: calc(1.75rem + env(safe-area-inset-left));
          padding-right: calc(1.75rem + env(safe-area-inset-right));
        }
      }
      @media (min-width: 1024px) {
        #main-container {
          padding-left: calc(2.5rem + env(safe-area-inset-left));
          padding-right: calc(2.5rem + env(safe-area-inset-right));
        }
      }
    </style>
    <PageTransition />

    {/* Confetti click effect */}
    <script>
      document.addEventListener('click', (e) => {
        const colors = ['#ff6b9d', '#ffd93d', '#6bcb77', '#4d96ff', '#ff8a5c', '#c44dff', '#ff6b6b', '#d4a84b', '#7dd3fc', '#f0abfc']
        const pieces = 28
        const container = document.body
        const types = ['ribbon', 'curl', 'dot', 'zigzag', 'squiggle']

        for (let i = 0; i < pieces; i++) {
          const el = document.createElement('div')
          const color = colors[Math.floor(Math.random() * colors.length)]
          const type = types[Math.floor(Math.random() * types.length)]
          let css = ''
          let base = 2 + Math.random() * 3

          switch (type) {
            case 'ribbon':
              css = `width: ${base * 1.2}px; height: ${base * 0.3}px; background: ${color}; border-radius: 1px;`
              break
            case 'curl':
              css = `width: ${base * 1.2}px; height: ${base * 0.5}px; background: ${color}; border-radius: 50% / 40% 60% 50% 50%;`
              break
            case 'dot':
              css = `width: ${base * 0.4}px; height: ${base * 0.4}px; background: ${color}; border-radius: 50%;`
              break
            case 'zigzag':
              css = `width: ${base}px; height: ${base * 0.6}px; background: ${color}; clip-path: polygon(0 0, 40% 30%, 100% 0, 80% 50%, 100% 100%, 40% 70%, 0 100%, 20% 50%);`
              break
            case 'squiggle':
              css = `width: ${base * 0.8}px; height: ${base * 0.3}px; background: ${color}; border-radius: 0 50% 50% 50%;`
              break
          }

          el.style.cssText = `
            position: fixed;
            left: ${e.clientX}px;
            top: ${e.clientY}px;
            ${css}
            pointer-events: none;
            z-index: 9999;
            opacity: 1;
          `

          container.appendChild(el)

          const angle = (Math.PI * 2 * (i / pieces)) + (Math.random() - 0.5) * 0.6
          const velocity = 30 + Math.random() * 50
          const vx = Math.cos(angle) * velocity
          const vy = Math.sin(angle) * velocity - 80

          let x = 0, y = 0
          let opacity = 1
          const gravity = 280 + Math.random() * 100
          let startTime = performance.now()
          const rotSpeed = (Math.random() - 0.5) * 500
          const drift = (Math.random() - 0.5) * 30

          function animate(time) {
            const dt = (time - startTime) / 1000
            x = vx * dt + drift * Math.sin(dt * 3)
            y = vy * dt + 0.5 * gravity * dt * dt
            opacity = 1 - dt / 1.8

            if (opacity <= 0) {
              el.remove()
              return
            }

            el.style.transform = `translate(${x}px, ${y}px) rotate(${dt * rotSpeed}deg) scale(${1 + Math.sin(dt * 5) * 0.2})`
            el.style.opacity = opacity
            requestAnimationFrame(animate)
          }

          requestAnimationFrame(animate)
        }
      })
    </script>
  </body>
</html>
