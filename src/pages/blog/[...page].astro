---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator } from 'astro-pure/components/pages'
import { getBlogCollection, getUniqueTagsWithCount, sortMDByDate } from 'astro-pure/server'
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import config from '@/site-config'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const collections = sortMDByDate(await getBlogCollection())
  const uniqueTags = getUniqueTagsWithCount(collections).map(([tag]) => tag)
  const collectionsCount = collections.length
  return paginate(collections, {
    pageSize: config.content.blogPageSize,
    props: { uniqueTags, collectionsCount }
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  uniqueTags: string[]
  collectionsCount: number
}

const { page, uniqueTags, collectionsCount } = Astro.props

const meta = {
  description: 'Some posts or archives of my blog',
  title: 'Blog'
}

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: `← Previous`,
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: `Next →`,
      url: page.url.next
    }
  })
}
---

<PageLayout {meta}>
  <main class='mt-8 lg:mt-12'>
    <!-- Blog header with Furina styling -->
    <div class='mb-10'>
      <span class='text-xs font-semibold uppercase tracking-[0.15em] text-[var(--muted-foreground)]/50'>
        {config.title}
      </span>
      <h1 class='font-heading mt-2 text-4xl sm:text-5xl font-[500] tracking-tight leading-tight'>
        文章
      </h1>
      <!-- Gold decorative line -->
      <div class='flex items-center gap-3 mt-3'>
        <span class='block w-8 h-px bg-gradient-to-r from-[var(--accent)]/60 to-transparent'></span>
        <span class='text-xs text-[var(--muted-foreground)]/50'>
          Page {page.currentPage} · {collectionsCount} posts
        </span>
      </div>
    </div>

    {
      page.data.length === 0 ? (
        <p class='text-[var(--muted-foreground)]/60'>No posts yet.</p>
      ) : (
        <div class='flex flex-col lg:flex-row gap-10'>
          {/* Main content: magazine grid */}
          <section class='flex-1 min-w-0' aria-label='Blog posts list'>
            <div class='grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6'>
              {page.data.map((post, index) => (
                <article class='blog-card group relative rounded-xl border border-[var(--primary)]/15 bg-[var(--card)]/20 hover:bg-[var(--card)]/40 transition-all duration-400'>
                  <a href={`/blog/${post.id}`} class='block p-5 sm:p-6' data-astro-prefetch>
                    <!-- Meta -->
                    <div class='flex items-center gap-2 text-[11px] text-[var(--muted-foreground)]/50 mb-3'>
                      <time datetime={post.data.publishDate?.toISOString()}>
                        {post.data.publishDate?.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric', year: 'numeric' })}
                      </time>
                    </div>

                    <!-- Title -->
                    <h2 class='font-heading text-base sm:text-lg font-[500] leading-snug mb-2 group-hover:text-[var(--primary)] transition-colors'>
                      {post.data.title}
                    </h2>

                    <!-- Description -->
                    {post.data.description && (
                      <p class='text-sm text-[var(--muted-foreground)]/60 leading-relaxed line-clamp-2 mb-3'>
                        {post.data.description}
                      </p>
                    )}

                    <!-- Tags + Read more -->
                    <div class='flex items-center justify-between pt-3 border-t border-[var(--border)]/15'>
                      <div class='flex flex-wrap gap-1.5'>
                        {post.data.tags?.slice(0, 2).map((tag: string) => (
                          <span class='text-[10px] px-2 py-0.5 rounded-full bg-[var(--muted)]/40 text-[var(--muted-foreground)]/50'>
                            {tag}
                          </span>
                        ))}
                      </div>
                      <span class='text-xs text-[var(--muted-foreground)]/30 group-hover:text-[var(--primary)]/50 transition-colors'>
                        Read →
                      </span>
                    </div>
                  </a>
                </article>
              ))}
            </div>

            <div class='mt-10'>
              <Paginator {...paginationProps} />
            </div>
          </section>

          {/* Sidebar — tags */}
          {!!uniqueTags.length && (
            <aside class='lg:w-56 shrink-0'>
              <div class='lg:sticky lg:top-24'>
                <div class='section-header flex items-center gap-3 mb-5'>
                  <span class='text-[#d4a84b]/40 text-sm'>◇</span>
                  <h2 class='text-xs font-semibold uppercase tracking-[0.15em] text-[var(--muted-foreground)]/50'>
                    标签
                  </h2>
                  <span class='h-px flex-1 bg-gradient-to-r from-[var(--border)] to-transparent'></span>
                </div>
                <ul class='flex flex-wrap gap-2'>
                  {uniqueTags.slice(0, 50).map((tag) => (
                    <li>
                      <a
                        href={`/tags/${tag}`}
                        class='tag-pill inline-block text-xs px-3 py-1.5 rounded-full border border-[var(--border)]/30 text-[var(--muted-foreground)]/60 hover:text-[var(--accent)] transition-colors'
                      >
                        #{tag}
                      </a>
                    </li>
                  ))}
                </ul>
                <div class='mt-6'>
                  <a
                    href='/tags'
                    class='text-xs text-[var(--muted-foreground)]/40 hover:text-[var(--accent)] transition-colors'
                  >
                    View all tags →
                  </a>
                </div>
              </div>
            </aside>
          )}
        </div>
      )
    }
  </main>
</PageLayout>

<style>
  .blog-card {
    position: relative;
  }

  .blog-card::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    background: linear-gradient(135deg, hsl(var(--primary) / 0.03) 0%, transparent 60%);
    transition: opacity 0.4s ease;
    pointer-events: none;
    border-radius: inherit;
  }

  .blog-card:hover::before {
    opacity: 1;
  }

  .blog-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px hsl(var(--primary) / 0.06);
  }

  :global(.dark) .blog-card:hover {
    box-shadow: 0 8px 30px hsl(220 30% 3% / 0.4);
  }

  /* Entry animation */
  @keyframes cardIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .blog-card:nth-child(1) { animation: cardIn 0.35s ease both 0.05s; }
  .blog-card:nth-child(2) { animation: cardIn 0.35s ease both 0.1s; }
  .blog-card:nth-child(3) { animation: cardIn 0.35s ease both 0.15s; }
  .blog-card:nth-child(4) { animation: cardIn 0.35s ease both 0.2s; }
  .blog-card:nth-child(5) { animation: cardIn 0.35s ease both 0.25s; }
  .blog-card:nth-child(6) { animation: cardIn 0.35s ease both 0.3s; }

  .section-header {
    user-select: none;
  }

  @media (max-width: 640px) {
    .blog-card {
      animation: cardIn 0.35s ease both !important;
    }
  }
</style>
