---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import { Quote } from 'astro-pure/advanced'
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import config from '@/site-config'

const MAX_POSTS = 10

const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#4A8BC2'>
  <main class='flex w-full flex-col'>
    {/* ===== Furina Masthead ===== */}
    <section class='masthead relative flex min-h-[75vh] w-full flex-col items-center justify-center overflow-hidden'>
      {/* Ocean depth gradient */}
      <div class='absolute inset-0 bg-gradient-to-b from-[#0a1628] via-[#0f1f3d] to-[#1a3055] pointer-events-none'></div>
      {/* Subtle radial glow */}
      <div class='furina-glow absolute top-1/4 left-1/2 -translate-x-1/2 w-[60vw] h-[40vh] pointer-events-none'></div>

      <div class='relative z-10 flex flex-col items-center px-4 max-w-3xl mx-auto text-center'>
        <!-- Avatar with animated golden halo -->
        <div class='mb-10 relative'>
          <div class='avatar-halo absolute inset-0 rounded-full bg-[#d4a84b]/15 blur-xl scale-150'></div>
          <Image
            src={images[imagePath]()}
            alt={config.logo.alt || 'Profile'}
            class='avatar-img rounded-full border-2 border-[#d4a84b]/30 shadow-2xl relative'
            style='width: 88px; height: 88px; object-fit: cover;'
            loading='eager'
            fetchpriority='high'
          />
        </div>

        <!-- Publication title — Furina's Tea Party in elegant French script -->
        <h1 class='masthead-title' style="font-family: 'Parisienne', cursive; font-size: 3.5rem; line-height: 1.2; color: #d4a84b; text-shadow: 0 2px 12px rgba(0,0,0,0.5);">
          {config.title}
        </h1>
        <style>
          @media (min-width: 640px) {
            .masthead-title { font-size: 5rem !important; }
          }
        </style>

        <!-- Decorative divider -->
        <div class='flex items-center gap-3 mt-2 mb-4'>
          <span class='block w-12 h-px bg-gradient-to-r from-transparent to-[#d4a84b]'></span>
          <span class='text-[#d4a84b] text-lg drop-shadow-[0_2px_6px_rgba(0,0,0,0.4)]'>◇</span>
          <span class='block w-12 h-px bg-gradient-to-l from-transparent to-[#d4a84b]'></span>
        </div>

        <!-- Tagline / description -->
        <p class='text-lg sm:text-xl text-[#4A8BC2] font-semibold max-w-lg leading-relaxed drop-shadow-[0_2px_6px_rgba(0,0,0,0.4)]'>
          {config.description}
        </p>

        <!-- Navigation — gold accent buttons -->
        <nav class='mt-8 flex flex-wrap justify-center gap-2 sm:gap-3'>
          {['文章', '标签', '关于'].map((label, i) => {
            const links = ['/blog', '/tags', '/about']
            return (
              <a
                href={links[i]}
                class='masthead-btn relative px-5 py-2 text-sm font-medium rounded-full border border-[#d4a84b]/30 text-[#d4a84b]/80 hover:text-white hover:bg-[#d4a84b]/20 hover:border-[#d4a84b]/60 transition-all duration-300 hover:scale-105'
              >
                {label}
              </a>
            )
          })}
        </nav>

        <!-- Social — light icons on dark bg -->
        <div class='mt-6 flex items-center gap-x-4'>
          <a
            href='https://github.com/borrrring'
            target='_blank'
            rel='noopener noreferrer'
            class='p-2 rounded-full text-[#4A8BC2] hover:text-[#d4a84b] transition-colors duration-300'
            aria-label='GitHub'
          >
            <Icon name='github' class='size-5' />
          </a>
          <a href='/rss.xml' class='p-2 rounded-full text-[#4A8BC2] hover:text-[#d4a84b] transition-colors duration-300' aria-label='RSS'>
            <Icon name='rss' class='size-5' />
          </a>
        </div>
      </div>

      {/* Bottom fade */}
      <div class='absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-[var(--background)] to-transparent pointer-events-none'></div>
    </section>

    {/* ===== Content Grid ===== */}
    <div class='magazine-content mx-auto w-full max-w-6xl px-4 sm:px-6 pb-16'>
      {
        allPostsByDate.length > 0 && (
          <>
            {/* Section header with gold accent */}
            <div class='section-header flex items-center justify-between mb-8'>
              <div class='flex items-center gap-3'>
                <span class='text-[#d4a84b] text-lg'>◇</span>
                <h2 class='font-heading text-lg font-[500] tracking-wide text-[var(--foreground)]'>
                  最新文章
                </h2>
              </div>
              <span class='h-px flex-1 bg-gradient-to-r from-[var(--border)] to-transparent mx-4'></span>
              <a href='/blog' class='text-sm text-[var(--muted-foreground)]/60 hover:text-[var(--accent)] transition-colors text-nowrap'>
                View all →
              </a>
            </div>

            {/* Featured post — large card with water-blue accent */}
            <article class='featured-card group relative mb-10 overflow-hidden rounded-2xl border border-[var(--primary)]/20 bg-[var(--card)]/40 hover:bg-[var(--card)]/60 transition-all duration-500'>
              <a href={`/blog/${allPostsByDate[0].id}`} class='block p-6 sm:p-8 md:p-10' data-astro-prefetch>
                <div class='flex flex-col md:flex-row md:items-start md:justify-between gap-6'>
                  <div class='flex-1 min-w-0'>
                    <div class='flex items-center gap-3 text-xs text-[var(--muted-foreground)]/60 mb-3'>
                      <time datetime={allPostsByDate[0].data.publishDate?.toISOString()}>
                        {allPostsByDate[0].data.publishDate?.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
                      </time>
                      <span class='w-1 h-1 rounded-full bg-[var(--border)]'></span>
                      <span class='featured-badge text-[var(--primary)] font-medium'>Featured</span>
                    </div>
                    <h2 class='font-heading text-2xl sm:text-3xl font-[500] leading-snug mb-3 group-hover:text-[var(--primary)] transition-colors'>
                      {allPostsByDate[0].data.title}
                    </h2>
                    {allPostsByDate[0].data.description && (
                      <p class='text-[var(--muted-foreground)]/70 text-sm sm:text-base leading-relaxed line-clamp-3'>
                        {allPostsByDate[0].data.description}
                      </p>
                    )}
                    <div class='flex flex-wrap gap-2 mt-4'>
                      {allPostsByDate[0].data.tags?.map((tag: string) => (
                        <span class='text-xs px-3 py-1 rounded-full bg-[var(--muted)]/60 text-[var(--muted-foreground)]/60'>
                          #{tag}
                        </span>
                      ))}
                    </div>
                  </div>
                  <div class='featured-arrow shrink-0 self-end md:self-center text-[var(--muted-foreground)]/20 group-hover:text-[var(--primary)]/60 transition-all duration-500 group-hover:translate-x-1'>
                    <svg width='32' height='32' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'>
                      <line x1='5' y1='12' x2='19' y2='12'></line>
                      <polyline points='12 5 19 12 12 19'></polyline>
                    </svg>
                  </div>
                </div>
              </a>
            </article>

            {/* Post grid */}
            <div class='post-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6'>
              {allPostsByDate.slice(1).map((post) => (
                <article class='post-card group relative rounded-xl border border-[var(--primary)]/15 bg-[var(--card)]/20 hover:bg-[var(--card)]/40 transition-all duration-400'>
                  <a href={`/blog/${post.id}`} class='block p-5 sm:p-6' data-astro-prefetch>
                    <div class='flex items-center gap-2 text-[11px] text-[var(--muted-foreground)]/50 mb-3'>
                      <time datetime={post.data.publishDate?.toISOString()}>
                        {post.data.publishDate?.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric', year: 'numeric' })}
                      </time>
                    </div>

                    <h3 class='font-heading text-base sm:text-lg font-[500] leading-snug mb-2 group-hover:text-[var(--primary)] transition-colors'>
                      {post.data.title}
                    </h3>

                    {post.data.description && (
                      <p class='text-sm text-[var(--muted-foreground)]/60 leading-relaxed line-clamp-2'>
                        {post.data.description}
                      </p>
                    )}

                    <div class='flex items-center justify-between mt-4 pt-3 border-t border-[var(--border)]/20'>
                      <div class='flex flex-wrap gap-1.5'>
                        {post.data.tags?.slice(0, 2).map((tag: string) => (
                          <span class='text-[10px] px-2 py-0.5 rounded-full bg-[var(--muted)]/40 text-[var(--muted-foreground)]/50'>
                            {tag}
                          </span>
                        ))}
                      </div>
                      <span class='text-xs text-[var(--muted-foreground)]/30 group-hover:text-[var(--primary)]/50 transition-colors'>
                        Read →
                      </span>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </>
        )
      }

      {/* About section */}
      <div class='mt-20'>
        <div class='section-header flex items-center mb-8'>
          <div class='flex items-center gap-3'>
            <span class='text-[#d4a84b] text-lg'>◇</span>
            <h2 class='font-heading text-lg font-[500] tracking-wide text-[var(--foreground)]'>
              关于
            </h2>
          </div>
          <span class='h-px flex-1 bg-gradient-to-r from-[var(--border)] to-transparent mx-4'></span>
        </div>
        <div class='about-card rounded-xl border border-[var(--primary)]/20 bg-[var(--card)]/30 p-6 sm:p-8'>
          <p class='text-[var(--muted-foreground)]/70 leading-relaxed'>
            我无限地爱着新的一日
          </p>
          <a href='/about' class='inline-flex items-center gap-1 mt-4 text-sm text-[var(--muted-foreground)]/50 hover:text-[var(--accent)] transition-colors'>
            More about me →
          </a>
        </div>
      </div>

      {/* Quote */}
      <Quote class='mt-16' />
    </div>
  </main>
</PageLayout>

<style>
  /* Masthead */
  .masthead {
    min-height: 60vh;
  }

  .masthead-title {
    letter-spacing: -0.03em;
  }

  .masthead-btn {
    backdrop-filter: blur(4px);
  }

  .furina-glow {
    background: radial-gradient(ellipse at center, rgba(74, 139, 194, 0.10) 0%, transparent 70%);
  }

  /* Animated avatar halo */
  @keyframes haloPulse {
    0%, 100% { opacity: 0.6; transform: scale(1.4); }
    50% { opacity: 1; transform: scale(1.6); }
  }
  .avatar-halo {
    animation: haloPulse 3s ease-in-out infinite;
  }
  @keyframes avatarGlow {
    0%, 100% { border-color: rgba(212, 168, 75, 0.3); box-shadow: 0 0 15px rgba(212, 168, 75, 0.15); }
    50% { border-color: rgba(212, 168, 75, 0.6); box-shadow: 0 0 25px rgba(212, 168, 75, 0.3); }
  }
  .avatar-img {
    animation: avatarGlow 3s ease-in-out infinite;
  }

  /* Featured card */
  .featured-card {
    position: relative;
  }

  .featured-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, hsl(var(--primary) / 0.06) 0%, transparent 50%);
    pointer-events: none;
  }

  .featured-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, hsl(var(--primary) / 0.3), transparent);
    pointer-events: none;
  }

  .featured-badge {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Post grid cards */
  .post-card {
    position: relative;
  }

  .post-card::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    background: linear-gradient(135deg, hsl(var(--primary) / 0.03) 0%, transparent 60%);
    transition: opacity 0.4s ease;
    pointer-events: none;
    border-radius: inherit;
  }

  .post-card:hover::before {
    opacity: 1;
  }

  /* Entry animation */
  @keyframes cardFadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .post-card:nth-child(1) { animation: cardFadeIn 0.4s ease both 0.1s; }
  .post-card:nth-child(2) { animation: cardFadeIn 0.4s ease both 0.15s; }
  .post-card:nth-child(3) { animation: cardFadeIn 0.4s ease both 0.2s; }
  .post-card:nth-child(4) { animation: cardFadeIn 0.4s ease both 0.25s; }
  .post-card:nth-child(5) { animation: cardFadeIn 0.4s ease both 0.3s; }
  .post-card:nth-child(6) { animation: cardFadeIn 0.4s ease both 0.35s; }

  /* Section header */
  .section-header {
    user-select: none;
  }

  /* About card */
  .about-card {
    position: relative;
  }

  /* Dark mode adjustments */
  :global(.dark) .featured-card {
    border-color: hsl(var(--primary) / 0.25);
  }

  :global(.dark) .post-card {
    border-color: hsl(var(--primary) / 0.12);
  }

  /* Hover lift effect for all cards */
  .featured-card:hover,
  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px hsl(var(--primary) / 0.08);
  }

  :global(.dark) .featured-card:hover,
  :global(.dark) .post-card:hover {
    box-shadow: 0 8px 30px hsl(220 30% 3% / 0.5);
  }

  /* Magazine content wrapper */
  .magazine-content {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 640px) {
    .masthead-title {
      font-size: 2.25rem;
    }
  }
</style>
